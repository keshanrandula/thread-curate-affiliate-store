# ==========================================
# THREAD & CURATE - Next.js Affiliate Shop
# Environment Configuration Template
# NOTE: Do NOT put real secrets/API keys in this file!
# Copy this file to `.env.local` and add your real keys.
# ==========================================

# Database: MongoDB (JSON/BSON document store)
# Example local: mongodb://127.0.0.1:27017/affiliate_shop
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/affiliate_shop?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/affiliate_shop

# Auth Secret for Admin Session JWT cookies (use a random string, minimum 32 chars)
AUTH_SECRET=your-secure-random-32-char-secret-key-here

# Default Admin Credentials (used on first seed/login fallback)
ADMIN_EMAIL=admin@affiliate.com
ADMIN_PASSWORD=change-me-admin123

# Storage Provider: 'local' | 'direct-url' | 'cloudinary'
STORAGE_PROVIDER=local

# Site URL (for SEO OpenGraph, sitemap, and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (Optional - only required if STORAGE_PROVIDER=cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
