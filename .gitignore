# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build outputs
/.next/
/out/
/build

# Vercel
.vercel

# Environment variables & secrets (CRITICAL: Never commit API keys or secrets)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.test
.env.production
!.env.example

# Local user uploaded media (keep folder structure via .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep

# SSL / Keys / Certificates / Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Antigravity / AI Agent temp logs
.agents/
.system_generated/
